TWILIO_ACCOUNT_SID=ACxxx
TWILIO_AUTH_TOKEN=xxx
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
GCP_PROJECT_ID=your-gcp-project-id
# --- LLM provider ---
LLM_PROVIDER=claude               # claude | nemotron
ANTHROPIC_API_KEY=xxx             # required when LLM_PROVIDER=claude
NEBIUS_API_KEY=xxx                # required when LLM_PROVIDER=nemotron (Nebius Token Factory)
#LLM_BASE_URL=https://api.tokenfactory.nebius.com/v1   # nemotron only; any OpenAI-compatible endpoint works
#LLM_MODEL=                       # default model for the provider (claude-sonnet-4-6 / nvidia/nemotron-3-super-120b-a12b)
#LLM_THINKING=off                 # nemotron only; 'on' re-enables chain-of-thought (slower, needs larger max_tokens)
ELEVENLABS_API_KEY=xxx
ELEVENLABS_VOICE_ID=xxx
DEEPGRAM_API_KEY=xxx              # optional — if set, uses Deepgram instead of Google STT
SERVER_PORT=8080
MEMORY_DEPTH=5
ALLOWED_EMAILS=dsidorenko@creativecaptains.com  # comma-separated, empty = allow all

