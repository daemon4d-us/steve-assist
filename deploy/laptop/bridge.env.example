# steve-bridge configuration (read from the environment or a .env in the cwd).
# Server selection: the local server is tried first; if it does not accept a
# WebSocket within BRIDGE_LOCAL_TIMEOUT_MS the cloud deployment is used.
STEVE_LOCAL_WS_URL=ws://127.0.0.1:8080/media-stream
STEVE_REMOTE_WS_URL=wss://steve-nb.creativecaptains.com/media-stream
BRIDGE_LOCAL_TIMEOUT_MS=1500
# How long to let the phone ring before the laptop answers (human can pick up first).
BRIDGE_ANSWER_DELAY_MS=1500
# Optional shared secret sent as customParameters.token (server support pending).
#BRIDGE_TOKEN=
# Keep the far-end voice audible on the laptop speakers during a bridged call.
BRIDGE_MONITOR=0
# Caller id used by `steve-bridge loopback` when none is given on the command line.
BRIDGE_LOOPBACK_PHONE=+16263993152
RUST_LOG=info
