# Copied to /opt/steve/.env on the VM (contains secrets — never commit the filled copy).
# LLM: Nemotron via Nebius Token Factory, pinned to us-central1.
LLM_PROVIDER=nemotron
NEBIUS_API_KEY=
LLM_BASE_URL=https://api.tokenfactory.us-central1.nebius.com/v1
#LLM_MODEL=nvidia/nemotron-3-super-120b-a12b
#LLM_THINKING=off

# Public hostname Twilio connects to (must match STEVE_DOMAIN / DNS / cert).
SERVER_HOST=steve-nb.creativecaptains.com
SERVER_PORT=8080

# GCP / Firestore
GCP_PROJECT_ID=steve-assist-491304

# Twilio, ElevenLabs, Deepgram, Google OAuth — copy from .env.prod
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
DEEPGRAM_API_KEY=
MEMORY_DEPTH=5
ALLOWED_EMAILS=
